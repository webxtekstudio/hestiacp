#!/bin/bash
# info: list php config parameters
# options: [FORMAT] [VERSION]
#
# example: v-list-sys-php-config
# example: v-list-sys-php-config json 8.3
#
# This function for obtaining the list of php config parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}
version=${2-}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	parse_object_kv_list $(echo "$config" | egrep "$keys" \
		| sed -e "s/[ ]*=/=/" -e "s/=[ ]*/=\'/" -e "s/$/'/")
	echo '{
    "CONFIG": {
        "memory_limit": "'$memory_limit'",
        "max_execution_time": "'$max_execution_time'",
        "max_input_time": "'$max_input_time'",
        "upload_max_filesize": "'$upload_max_filesize'",
        "post_max_size": "'$post_max_size'",
        "display_errors": "'$display_errors'",
        "error_reporting": "'$error_reporting'",
        "config_path": "'$config_path'"
        }
}'
}

# SHELL list function
shell_list() {
	echo "$config" | egrep "$keys" | tr -d '='
	echo "config_path $config_path"
}

# PLAIN list function
plain_list() {
	echo "$config" | egrep "$keys" | tr -d '='
	echo "config_path $config_path"
}

# CSV list function
csv_list() {
	echo "$keys" | sed "s/ |/,/g"
	echo "$config" | egrep "$keys" | tr -d '=' | awk '{print $2}' | tr '\n' ','
	echo
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Defining config path
config_path=""
if [ -n "$version" ]; then
	if ! [[ "$version" =~ ^[0-9]+\.[0-9]+$ ]]; then
		check_result "$E_INVALID" "invalid php version format :: $version"
	fi
	if [ -f "/etc/php/$version/fpm/php.ini" ] && { [ "$WEB_BACKEND" = 'php-fpm' ] || [ -d "/etc/php/$version/fpm/pool.d" ] || [ ! -f "/etc/php/$version/apache2/php.ini" ]; }; then
		config_path="/etc/php/$version/fpm/php.ini"
	elif [ -f "/etc/php/$version/apache2/php.ini" ]; then
		config_path="/etc/php/$version/apache2/php.ini"
	elif [ -f "/etc/php/$version/cli/php.ini" ]; then
		config_path="/etc/php/$version/cli/php.ini"
	else
		check_result "$E_NOTEXIST" "php $version config doesn't exist"
	fi
else
	default_version=$(multiphp_default_version)
	if [ -n "$default_version" ] && { [ "$WEB_BACKEND" = 'php-fpm' ] || [ -d "/etc/php/$default_version/fpm/pool.d" ]; } && [ -f "/etc/php/$default_version/fpm/php.ini" ]; then
		config_path="/etc/php/$default_version/fpm/php.ini"
	else
		all_configs=$(find /etc/php* -name php.ini 2> /dev/null | sort -V)
		multiphp_pool_count=$(find /etc/php -maxdepth 3 -type d -path '/etc/php/*/fpm/pool.d' 2> /dev/null | wc -l)
		if [ "$WEB_BACKEND" = 'php-fpm' ] || [ "$multiphp_pool_count" -gt 0 ]; then
			config_path=$(echo "$all_configs" | grep '/fpm/php\.ini$' | tail -n 1)
		else
			config_path=$(echo "$all_configs" | grep '/apache2\?/php\.ini$' | tail -n 1)
		fi
		if [ -z "$config_path" ]; then
			config_path=$(echo "$all_configs" | tail -n 1)
		fi
	fi
fi

if [ -z "$config_path" ] || [ ! -f "$config_path" ]; then
	check_result "$E_NOTEXIST" "php config doesn't exist"
fi

# Defining keys
keys="memory_limit |max_execution_time |max_input_time"
keys="$keys |upload_max_filesize |post_max_size"
keys="$keys |display_errors |error_reporting "

# Reading config
config=$(grep -v "^;" "$config_path")

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
